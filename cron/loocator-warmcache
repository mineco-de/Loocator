# /etc/cron.d/loocator-warmcache - wärmt nachts den Overpass-Kachel-Cache der größten Städte (siehe warmcache.php).
# Läuft nach cleanup.php (03:00). Installation: sudo cp cron/loocator-warmcache /etc/cron.d/ && sudo chmod 644 /etc/cron.d/loocator-warmcache
30 4 * * * loocator /usr/bin/php /var/www/html/loocator/app/warmcache.php >> /var/www/html/loocator/app/warmcache.log 2>&1
